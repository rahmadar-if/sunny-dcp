{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "queue:default": "php artisan queue:listen redis --queue=default,notification",
        "queue:batch": "php artisan queue:listen redis --queue=batch-delete,export,import",
        "queue:email-blast": "php artisan queue:listen redis --queue=email-blast-webhook,email-blast-schedule,email-blast",
        "queue:wa-blast": "php artisan queue:listen redis --queue=wa-blast-webhook,wa-blast-schedule,wa-blast",
        "queue:wa": "php artisan queue:listen redis --queue=wa-webhook,wa-media",
        "wa-bridge": "php artisan solaris:whatsapp sunny redis-subscribe",
        "queue:wa-ai": "php artisan queue:listen redis --queue=wa-ai",
        "reverb": "php artisan reverb:start",
        "schedule": "php artisan schedule:work",
        "web": "concurrently \"php artisan serve\" \"npm run dev\"",
        "worker": "concurrently \"npm run queue:default\" \"npm run queue:batch\" \"npm run queue:email-blast\" \"npm run queue:wa-blast\" \"npm run reverb\" \"npm run schedule\"",
        "whatsapp": "concurrently \"npm run queue:wa-notif\" \"npm run queue:wa\" \"npm run wa-bridge\" \"npm run queue:wa-ai\"",
        "full": "concurrently \"npm run web\" \"npm run worker\" \"npm run whatsapp\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^1.2.0",
        "tailwindcss": "^4.0.0",
        "vite": "^6.0.11",
        "glob": "^11.1.0",
        "laravel-echo": "^2.3.1",
        "pusher-js": "^8.4.3",
        "sass-embedded": "^1.98.0"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "@simonwep/pickr": "^1.9.1",
        "@yaireo/tagify": "^4.36.0",
        "animejs": "^4.3.6",
        "apexcharts": "^5.10.4",
        "block-ui": "^2.70.1",
        "bootstrap": "^5.3.8",
        "ckeditor5": "~47.6.1",
        "cleave.js": "^1.6.0",
        "compressorjs": "^1.2.1",
        "cropperjs": "^1.6.2",
        "datatables.net-dt": "^2.3.7",
        "datatables.net-scroller-dt": "^2.4.3",
        "datatables.net-fixedcolumns-dt": "^5.0.5",
        "dragula": "^3.7.3",
        "dropzone": "^6.0.0-beta.2",
        "flatpickr": "^4.6.13",
        "fullcalendar": "^6.1.20",
        "google-libphonenumber": "^3.2.42",
        "jquery": "^3.7.1",
        "moment": "^2.30.1",
        "node-waves": "^0.7.6",
        "photoswipe": "^5.4.4",
        "quill": "^2.0.2",
        "rater-js": "^1.0.1",
        "shepherd.js": "^14.5.1",
        "simplebar": "^6.3.3",
        "slick-slider": "^1.8.2",
        "sortablejs": "^1.15.7",
        "sweetalert2": "^11.26.24",
        "swiper": "^12.1.3",
        "toastify-js": "^1.12.0",
        "wnumb": "^1.2.0"
    }
}
